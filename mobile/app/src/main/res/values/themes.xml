<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.GabAi" parent="Theme.Material3.Light.NoActionBar">
        <!-- design.md inspired palette -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/primary</item>
        <item name="colorOnPrimaryContainer">@color/on_primary</item>

        <!-- Use framework background attrs for compatibility -->
        <item name="android:colorBackground">@color/canvas</item>
        <item name="android:windowBackground">@color/canvas</item>

        <item name="colorOnBackground">@color/ink</item>
        <item name="colorSurface">@color/canvas</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorSurfaceVariant">@color/surface_card</item>
        <item name="colorOnSurfaceVariant">@color/body</item>

        <item name="android:statusBarColor">@color/surface_dark</item>
        <item name="android:navigationBarColor">@color/surface_dark</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>

    <style name="Theme.GabAi" parent="Base.Theme.GabAi" />
</resources>