<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.GabAi" parent="Theme.Material3.Light.NoActionBar">
        <!-- ── Primary: Muted Coral ── -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/primary_light</item>
        <item name="colorOnPrimaryContainer">@color/ink</item>

        <!-- ── Background: Warm Cream ── -->
        <item name="android:colorBackground">@color/canvas</item>
        <item name="android:windowBackground">@color/canvas</item>
        <item name="colorOnBackground">@color/ink</item>

        <!-- ── Surface ── -->
        <item name="colorSurface">@color/canvas</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorSurfaceVariant">@color/surface_card</item>
        <item name="colorOnSurfaceVariant">@color/body</item>

        <!-- ── Status bar: warm cream to match canvas ── -->
        <item name="android:statusBarColor">@color/canvas</item>
        <item name="android:navigationBarColor">@color/canvas</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>

    <style name="Theme.GabAi" parent="Base.Theme.GabAi" />

    <!-- ── Text Appearances ── -->
    <style name="GabAi.Text" parent="">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/body</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:lineSpacingMultiplier">1.4</item>
    </style>

    <style name="GabAi.Text.Display">
        <item name="android:textSize">@dimen/text_display</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:fontFamily">serif</item>
        <item name="android:textStyle">normal</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
    </style>

    <style name="GabAi.Text.Headline">
        <item name="android:textSize">@dimen/text_headline</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:fontFamily">serif</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
    </style>

    <style name="GabAi.Text.Title">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>

    <style name="GabAi.Text.Body">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/body</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:lineSpacingMultiplier">1.4</item>
    </style>

    <style name="GabAi.Text.BodyLarge">
        <item name="android:textSize">@dimen/text_body_lg</item>
        <item name="android:textColor">@color/body</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:lineSpacingMultiplier">1.4</item>
    </style>

    <style name="GabAi.Text.Caption">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
    </style>

    <style name="GabAi.Text.OnDark">
        <item name="android:textSize">@dimen/text_body_lg</item>
        <item name="android:textColor">@color/on_dark</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:lineSpacingMultiplier">1.4</item>
    </style>

    <style name="GabAi.Text.OnDark.Headline">
        <item name="android:textSize">@dimen/text_headline</item>
        <item name="android:textColor">@color/on_dark</item>
        <item name="android:fontFamily">serif</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
    </style>
</resources>