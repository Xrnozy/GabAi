<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="32dp"
        android:importantForAccessibility="yes"
        android:text="Choose a mode"
        android:textColor="@color/ink"
        android:textSize="36sp"
        android:textStyle="normal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_hint"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="16dp"
        android:importantForAccessibility="yes"
        android:text="Say Navigation, A S L, O C R, or Color"
        android:textColor="@color/body"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_title" />

    <Button
        android:id="@+id/btn_navigation"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="28dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_button_primary"
        android:importantForAccessibility="yes"
        android:minHeight="80dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:text="Navigation"
        android:textAllCaps="false"
        android:textColor="@color/on_primary"
        android:textSize="26sp"
        android:accessibilityHeading="false"
        android:contentDescription="Navigation"
        app:layout_constraintBottom_toTopOf="@id/btn_asl"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_default="percent"
        app:layout_constraintHeight_percent="0.20"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_hint" />

    <Button
        android:id="@+id/btn_asl"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_button_secondary"
        android:contentDescription="American Sign Language"
        android:importantForAccessibility="yes"
        android:minHeight="120dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:text="ASL"

        android:textAllCaps="false"
        android:textColor="@color/on_primary"
        android:textSize="26sp"
        app:layout_constraintBottom_toTopOf="@id/btn_ocr"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_default="percent"
        app:layout_constraintHeight_percent="0.20"
        app:layout_constraintHorizontal_bias="0.125"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_navigation" />

    <Button
        android:id="@+id/btn_ocr"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_button_secondary"
        android:contentDescription="Optical Character Recognition"
        android:importantForAccessibility="yes"
        android:minHeight="120dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:text="OCR"
        android:textAllCaps="false"
        android:textColor="@color/on_primary"
        android:textSize="26sp"
        app:layout_constraintBottom_toTopOf="@id/btn_color"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_default="percent"
        app:layout_constraintHeight_percent="0.20"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_asl" />

    <Button
        android:id="@+id/btn_color"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="32dp"
        android:background="@drawable/bg_button_secondary"
        android:contentDescription="Color understanding"
        android:importantForAccessibility="yes"
        android:minHeight="120dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:text="Color"
        android:textAllCaps="false"
        android:textColor="@color/on_primary"
        android:textSize="26sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_default="percent"
        app:layout_constraintHeight_percent="0.20"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_ocr" />

</androidx.constraintlayout.widget.ConstraintLayout>